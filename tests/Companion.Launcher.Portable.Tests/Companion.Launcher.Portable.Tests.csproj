<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Companion.Launcher.Avalonia/Companion.Launcher.Avalonia.csproj" />
    <ProjectReference Include="../../samples/SampleEngine/SampleEngine.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <Content Include="../../samples/Companion.Demo/Data/*.json" Link="Data/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyFixture" AfterTargets="Build">
    <ItemGroup><EngineFiles Include="../../samples/SampleEngine/bin/$(Configuration)/net8.0/SampleEngine*" /></ItemGroup>
    <Copy SourceFiles="@(EngineFiles)" DestinationFolder="$(TargetDir)Engine" />
  </Target>
</Project>
