<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Companion.Launcher.Windows/Companion.Launcher.Windows.csproj" />
    <ProjectReference Include="../../samples/SampleEngine/SampleEngine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopySyntheticEngine" AfterTargets="Build">
    <ItemGroup>
      <SyntheticEngineFiles Include="../../samples/SampleEngine/bin/$(Configuration)/net8.0/*" />
    </ItemGroup>
    <Copy SourceFiles="@(SyntheticEngineFiles)" DestinationFolder="$(OutDir)Engine" />
  </Target>
</Project>
