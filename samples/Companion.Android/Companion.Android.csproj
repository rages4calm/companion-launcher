<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework><OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion><ApplicationId>org.companion.template</ApplicationId>
    <ApplicationTitle>Companion Template</ApplicationTitle><ApplicationVersion>2</ApplicationVersion><ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats><PublishTrimmed>false</PublishTrimmed><RunAOTCompilation>false</RunAOTCompilation><AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)'==''">android-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Companion.Launcher.Avalonia/Companion.Launcher.Avalonia.csproj" />
    <ProjectReference Include="../../src/Companion.Launcher.Android/Companion.Launcher.Android.csproj" />
    <ProjectReference Include="../PortableDemo.Shared/PortableDemo.Shared.csproj" />
    <PackageReference Include="Avalonia.Android" Version="12.1.4" />
  </ItemGroup>
</Project>
